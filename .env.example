PORT=3000
HOST=0.0.0.0
APP_URL=http://localhost:3000
SESSION_SECRET=replace-with-a-long-random-string

DB_HOST=localhost
DB_PORT=5432
DB_NAME=sherubtse_freelance_db
DB_USER=postgres
DB_PASS=your_postgresql_password

MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=sherubtse_freelance_feedback

# Sending Gmail account with 2-Step Verification enabled.
GMAIL_USER=your_sender_account@gmail.com
# Google App Password, NOT your Gmail sign-in password. Never commit the real value.
GMAIL_APP_PASSWORD=your_16_character_google_app_password

ADMIN_NAME=System Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your_admin_password

# datetime-local work inputs are interpreted in Bhutan time.
TZ=Asia/Thimphu

# Optional path when pg_dump is not in a standard location.
# PG_DUMP_PATH=C:/Program Files/PostgreSQL/18/bin/pg_dump.exe
