# Safe placeholders only. Never commit a populated environment file.
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
SESSION_SECRET=replace-with-a-random-secret-of-at-least-32-characters
DATABASE_URL=postgresql://user:placeholder@localhost:5432/sherubtse_freelance_db
DB_SSL=false
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=sherubtse_freelance_feedback
EMAIL_PROVIDER=gmail
GMAIL_USER=your_sender@example.invalid
GMAIL_APP_PASSWORD=your_app_password
GOOGLE_CLIENT_ID=your_client_id
GOOGLE_CLIENT_SECRET=your_client_secret
GOOGLE_REFRESH_TOKEN=your_refresh_token
RESEND_API_KEY=your_api_key
EMAIL_FROM=your_sender@example.invalid
ADMIN_NAME=System Administrator
ADMIN_EMAIL=your_admin@example.invalid
ADMIN_PASSWORD=replace-with-a-strong-unique-password
# Local-only optional demo settings. Never enable these on Render.
ALLOW_DEMO_SEED=false
DEMO_SEED_PASSWORD=
# Optional tooling and reverse-proxy configuration.
PG_DUMP_PATH=
TRUST_PROXY_HOPS=1
