<%- include('../partials/header') %>
<section class="page-title"><span class="eyebrow">Administration</span><h1>A trusted community starts here.</h1><p>Review employer requests and manage community accounts.</p></section>
<div class="stats-grid"><% [['Pending approvals',pendingEmployers.length],['Accounts in view',accounts.length],['Accepted',applications.filter(a=>['accepted','in_progress'].includes(a.status)).length],['Rejected',applications.filter(a=>a.status==='rejected').length]].forEach(([label,value])=>{ %><div class="stat-card"><span><%= label %></span><strong><%= value %></strong></div><% }) %></div><h2>Pending employer approvals</h2><div class="people-list">
  <% if (!pendingEmployers.length) { %><p class="empty">No employer requests are waiting.</p><% } %>
  <% pendingEmployers.forEach(employer => { %><article class="person-row"><div><strong><%= employer.name %></strong><span><%= employer.email %> · Requested <%= date(employer.created_at) %></span></div><div class="row-actions"><form method="POST" action="/admin/employers/<%= employer.id %>/approve" data-confirm="Approve this employer to post work and recruit students?"><button class="btn">Approve</button></form><form method="POST" action="/admin/employers/<%= employer.id %>/reject" data-confirm="Reject this employer request?"><label>Reason for rejection<input name="reason" maxlength="500" placeholder="Explain your decision"></label><button class="btn danger">Reject</button></form></div></article><% }) %>
</div>
<section class="panel"><h2>All accounts and applications</h2><form method="GET" action="/admin" class="form-grid"><label>Name, email or student number<input name="q" value="<%= filters.q %>"></label><label>Role<select name="role"><% [['','All roles'],['student','Student'],['employer','Employer'],['both','Both roles'],['admin','Administrator']].forEach(([v,l])=>{ %><option value="<%= v %>" <%= filters.role===v?'selected':'' %>><%= l %></option><% }) %></select></label><label>Email verification<select name="verified"><option value="">All accounts</option><option value="true" <%= filters.verified==='true'?'selected':'' %>>Verified</option><option value="false" <%= filters.verified==='false'?'selected':'' %>>Unverified</option></select></label><label>Employer approval<select name="approval"><% ['','not_requested','pending','approved','rejected'].forEach(v=>{ %><option value="<%= v %>" <%= filters.approval===v?'selected':'' %>><%= v || 'All approval statuses' %></option><% }) %></select></label><label>Application status<select name="status"><% ['','pending','invited','accepted','in_progress','rejected','declined','withdrawn','completed'].forEach(v=>{ %><option value="<%= v %>" <%= filters.status===v?'selected':'' %>><%= v || 'All application statuses' %></option><% }) %></select></label><button class="btn">Search and filter</button><a href="/admin">Reset filters</a></form>
<h3>Accounts (<%= accounts.length %>)</h3><div class="table-wrap" role="region" aria-label="Administrator records" tabindex="0"><table><thead><tr><th>Account</th><th>Student number</th><th>Roles</th><th>Verification / approval</th></tr></thead><tbody><% if(!accounts.length){ %><tr><td colspan="4">No accounts match your filters.</td></tr><% } %><% accounts.forEach(a=>{ %><tr><td><a href="/profiles/<%= a.id %>"><%= a.name %></a><br><%= a.email %></td><td><%= a.student_number || 'Not applicable' %></td><td><%= a.is_student?'Student ':'' %><%= a.is_employer?'Employer ':'' %><%= a.is_admin?'Admin':'' %></td><td><%= a.is_verified?'Verified':'Unverified' %> / <%= a.employer_status %></td></tr><% }) %></tbody></table></div>
<h3>Applications (<%= applications.length %>)</h3><div class="table-wrap" role="region" aria-label="Administrator records" tabindex="0"><table><thead><tr><th>Student</th><th>Work / employer</th><th>Status</th><th>Applied</th></tr></thead><tbody><% if(!applications.length){ %><tr><td colspan="4">No applications match your filters.</td></tr><% } %><% applications.forEach(a=>{ %><tr><td><a href="/profiles/<%= a.student_id %>"><%= a.name %></a></td><td><%= a.title %><br><%= a.employer_name %></td><td><span class="status <%= a.status %>"><%= statusLabel(a.status) %></span></td><td><%= dateTime(a.created_at) %></td></tr><% }) %></tbody></table></div></section>
<%- include('../partials/footer') %>
