<section class="panel"><h2>Reports and disputes</h2><% if(!reports.length){ %><p class="empty">No reports match this view.</p><% } %>
<% reports.forEach(r=>{ %><article class="rating-card"><h3>#<%= r.id %> · <%= r.subject %></h3><p><%= r.kind %> · Reporter #<%= r.reporter_id %> · User #<%= r.target_user_id || '—' %> · Job #<%= r.job_id || '—' %> · <%= r.status %></p><p><%= r.details %></p><p><%= r.resolution %></p><form method="POST" action="/admin/reports/<%= r.id %>" class="stack-form" data-confirm="Save this report decision?">
<input type="hidden" name="_csrf" value="<%= typeof csrfToken==='string'?csrfToken:'' %>"><label>Status<select name="status"><% ['under_review','resolved','dismissed'].forEach(s=>{ %><option <%= r.status===s?'selected':'' %>><%= s %></option><% }) %></select></label><label>Response<textarea name="resolution" maxlength="1500" required><%= r.resolution %></textarea></label><button class="btn">Save decision</button></form></article><% }) %></section>
<section class="panel"><h2>Job moderation</h2><% moderationJobs.forEach(j=>{ %><article class="person-row"><div><a href="/jobs/<%= j.id %>"><%= j.title %></a><p><%= jobState(j) %></p></div><form method="POST" action="/admin/jobs/<%= j.id %>/status" data-confirm="Change this job's visibility?">
<input type="hidden" name="_csrf" value="<%= typeof csrfToken==='string'?csrfToken:'' %>"><input type="hidden" name="action" value="<%= j.is_suspended?'reactivate':'suspend' %>"><label>Reason<input name="reason" required maxlength="1500"></label><button class="btn secondary"><%= j.is_suspended?'Reactivate':'Suspend' %></button></form></article><% }) %></section>
<section class="panel"><h2>Review moderation</h2><% moderationRatings.forEach(r=>{ %><article class="rating-card"><strong><%= r.score %>/5 · Job #<%= r.jobId %> · Employee #<%= r.employeeId %></strong><p><%= r.comment %></p><p><%= r.hidden?'Hidden':'Visible' %> · <%= r.moderationReason || '' %></p><form method="POST" action="/admin/ratings/<%= r._id %>" data-confirm="Change review visibility?">
<input type="hidden" name="_csrf" value="<%= typeof csrfToken==='string'?csrfToken:'' %>"><input type="hidden" name="action" value="<%= r.hidden?'restore':'hide' %>"><label>Moderation reason<input name="reason" required maxlength="1500"></label><button class="btn secondary"><%= r.hidden?'Restore':'Hide review' %></button></form></article><% }) %></section>
<section class="panel"><h2>Activity and moderation history</h2><% auditRecords.forEach(a=>{ %><p><strong><%= a.action %></strong> · <%= a.target_type %> #<%= a.target_id %> · Administrator #<%= a.actor_id %><br><%= a.note %><br><small><%= dateTime(a.created_at) %></small></p><% }) %><h3>Application history</h3><% applicationHistory.forEach(a=>{ %><p>Application #<%= a.application_id %> · <%= statusLabel(a.status) %> · <%= dateTime(a.changed_at) %></p><% }) %></section>
