<article class="job-card" data-work-card data-search="<%= [job.title,job.employer_name,job.location,job.work_type,job.requirements].join(' ').toLowerCase() %>" data-type="<%= job.work_type %>" data-urgency="<%= job.urgency %>" data-location="<%= job.location.toLowerCase() %>" data-date="<%= new Date(new Date(job.start_at).getTime()+6*3600000).toISOString().slice(0,10) %>" data-created="<%= new Date(job.created_at || job.published_at).getTime() %>" data-closing="<%= new Date(job.application_closes_at).getTime() %>" data-wage="<%= Number(job.wage_rate) %>">
<div class="card-top">
<span class="tag">
<%= job.work_type %>
</span>
<% if(job.urgency==='urgent'){ %>
<span class="tag urgent">Urgent</span>
<% }else{ %>
<span class="open-indicator">Applications open</span>
<% } %>
</div>
<h3>
<a href="/jobs/<%= job.id %>">
<%= job.title %>
</a>
</h3>
<p class="small"><span class="status"><%= job.employer_status==='approved' ? 'Approved employer' : 'Employer approval pending' %></span> &middot; <%= jobState(job) %></p><p class="business-line">
<%= job.employer_name %> &middot; <%= job.location %>
</p>
<p class="wage">Nu. <%= Number(job.wage_rate).toLocaleString('en-GB') %>
<small> / <%= job.wage_unit %>
</small>
</p>
<dl>
<div>
<dt>Schedule</dt>
<dd>
<%= dateTime(job.start_at) %>
<br>to <%= dateTime(job.end_at) %>
</dd>
</div>
<div>
<dt>Working hours</dt><dd><%= Math.round((new Date(job.end_at)-new Date(job.start_at))/3600000*10)/10 %> hours</dd></div><div><dt>Skills</dt><dd><%= job.requirements || 'See work details' %></dd></div><div><dt>Workers needed</dt>
<dd>
<%= job.workers_needed %>
</dd>
</div>
<div>
<dt>Apply by</dt>
<dd>
<%= dateTime(job.application_closes_at) %>
</dd>
</div>
</dl>
<a class="text-link card-link" href="/jobs/<%= job.id %>">View opportunity <span aria-hidden="true">&#8599;</span>
</a>
</article>
