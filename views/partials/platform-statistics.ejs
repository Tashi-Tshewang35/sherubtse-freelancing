<% if(user && user.isAdmin && typeof statistics!=='undefined'){ %>
<section class="stats-grid" aria-label="Platform statistics">
<% [['Verified students',statistics.students],['Approved employers',statistics.employers],['Completed placements',statistics.completed]].forEach(([label,value])=>{ %>
<div class="stat-card"><span><%= label %></span><strong><%= value %></strong></div>
<% }) %>
</section>
<% } %>
