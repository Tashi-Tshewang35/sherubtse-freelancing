<%- include('../partials/header') %>
<section class="auth-card"><span class="eyebrow">Account recovery</span><h1>Forgot password?</h1>
<p>Enter your registered email. If your account is eligible, we will send a link valid for 30 minutes.</p>
<form method="POST" action="/forgot-password" class="stack-form">
<input type="hidden" name="_csrf" value="<%= typeof csrfToken==='string'?csrfToken:'' %>">
<label>Email address<input type="email" name="email" autocomplete="email" required maxlength="150"></label>
<button class="btn">Send reset link</button></form><p><a href="/login">Back to login</a></p></section>
<%- include('../partials/footer') %>
