<%- include('../partials/header') %>
<section class="auth-card"><span class="eyebrow">Account recovery</span><h1>Choose a new password</h1>
<form method="POST" action="/reset-password/<%= token %>" class="stack-form">
<input type="hidden" name="_csrf" value="<%= typeof csrfToken==='string'?csrfToken:'' %>">
<label>New password<input type="password" name="password" autocomplete="new-password" minlength="8" required data-strength aria-describedby="password-strength"></label>
<p id="password-strength" class="field-help" role="status">Use at least 8 characters. Longer, unique passwords are stronger.</p>
<label>Confirm new password<input type="password" name="confirmPassword" autocomplete="new-password" minlength="8" required></label>
<button class="btn">Reset password</button></form></section>
<%- include('../partials/footer') %>
