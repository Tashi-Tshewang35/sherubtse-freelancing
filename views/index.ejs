</div>
<span aria-hidden="true">&#8599;</span>
</div>
<div class="schedule-preview">
<span class="schedule-icon" aria-hidden="true">02</span>
<div>
<strong>Keep life in balance</strong>
<span>Work and study in one calendar</span>
</div>
<span aria-hidden="true">&#8599;</span>
</div>
<div class="hero-panel-bottom">SHERUBTSE COLLEGE <span>KANGLUNG, BHUTAN</span>
</div>
</aside>
</section>
<% if(typeof statistics!=='undefined'){ %><section class="stats-grid" aria-label="Platform statistics"><% [['Verified students',statistics.students],['Approved employers',statistics.employers],['Completed placements',statistics.completed]].forEach(([label,value])=>{ %><div class="stat-card"><span><%= label %></span><strong><%= value %></strong></div><% }) %></section><% } %>
<section class="benefit-strip" aria-label="Our community commitments">
<div>
<span class="benefit-icon" aria-hidden="true">&#8599;</span>
<div>
<strong>A community you can trust</strong>
<p>Education email verification for students</p>
</div>
</div>
<div>
<span class="benefit-icon" aria-hidden="true">&#8599;</span>
<div>
<strong>Experience that matters</strong>
<p>Build skills and a work reputation</p>
</div>
</div>
<div>
<span class="benefit-icon" aria-hidden="true">&#8599;</span>
<div>
<strong>Local connections</strong>
<p>Work with approved community employers</p>
</div>
</div>
</section>
<section aria-labelledby="featured-title">
<div class="section-heading">
<div>
<span class="eyebrow">A good place to start</span>
<h2 id="featured-title">Find your next opportunity</h2>
<p>Real work. Clear schedules. Right here in Kanglung.</p>
</div>
<a class="text-link" href="/jobs">View all work &#8594;</a>
</div>
<div class="card-grid">
<% if(!jobs.length){ %>
<div class="empty-state">
<span class="eyebrow">New possibilities ahead</span>
<h3>No available work just yet</h3>
<p>Approved employers will post opportunities here. Build your profile so you are ready to apply.</p>
<a class="btn secondary" href="<%= user ? '/profile' : '/signup' %>">Get ready for your first opportunity</a>
</div>
<% } %>
<% jobs.forEach(job=>{ %>
<%- include('partials/job-card',{job}) %>
<% }) %>
</div>
</section>
<section id="how-it-works" class="how-section">
<div class="section-heading">
<div>
<span class="eyebrow">Simple from the start</span>
<h2>A few steps to meaningful work</h2>
</div>
</div>
<div class="three-columns">
<article class="step-card">
<span class="step-number">01</span>
<h3>Create &amp; verify</h3>
<p>Register with your Sherubtse education email. Employers verify their email and receive administrator approval.</p>
</article>
<article class="step-card">
<span class="step-number">02</span>
<h3>Find the right fit</h3>
<p>Compare wages and schedules, share your skills and apply. Keep your availability up to date.</p>
</article>
<article class="step-card">
<span class="step-number">03</span>
<h3>Work &amp; grow</h3>
<p>Track your application, complete your work and build a reputation through employer feedback.</p>
</article>
</div>
</section>
<section class="employer-banner">
<div>
<span class="eyebrow">For local employers</span>
<h2>Good people. Right in your community.</h2>
<p>Find verified students for your business, event or next project.<br>Post clear expectations and an agreed wage to get started.</p>
</div>
<a class="btn" href="<%= user ? '/dashboard' : '/signup' %>">Start hiring &#8599;</a>
</section>
<section class="panel"><h2>A pathway for everyone</h2><div class="three-columns"><article><h3>Students</h3><p>Build your profile, find work around your studies and grow your reputation.</p><a href="/signup">Join as a student</a></article><article><h3>Local employers</h3><p>Post clear work and recruit verified students with the skills you need.</p><a href="/employer-responsibilities">Employer responsibilities</a></article><article><h3>Need a hand?</h3><p>Find answers, understand the rules and get support.</p><a href="/help">Visit the Help Centre</a></article></div></section><section class="panel"><h2>Common questions</h2><details><summary>How do payments work?</summary><p>Payments are handled directly between employer and employee. Agree wages and timing before work.</p></details><details><summary>Can I work and hire?</summary><p>Choose a combined account and switch dashboards with the same verified student identity.</p></details><p><a href="/faq">Read all FAQs</a> ? <a href="/contact">Contact support</a></p><p class="safety-note">Stay safe: never pay an advance fee, share passwords or accept unsafe work. Report concerns to administrators.</p></section>
<%- include('partials/footer') %>