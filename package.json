{
  "name": "sherubtse-freelance",
  "version": "1.0.0",
  "description": "Sherubtse Freelancing: student freelancing for the Kanglung community",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon --exec \"node -r ./config/development.js\" server.js",
    "seed:admin": "node scripts/seedAdmin.js",
    "migrate:verification": "node scripts/migrateVerification.js",
    "test": "jest --runInBand",
    "migrate:profiles": "node scripts/migrateProfiles.js",
    "migrate:ui": "node scripts/migrateUI.js",
    "check:ui": "node scripts/checkUI.js",
    "preview:ui": "node scripts/previewUI.js",
    "test:unit": "jest --runInBand --testPathPatterns=unit",
    "test:coverage": "jest --runInBand --coverage",
    "test:setup": "node scripts/setupTestDatabases.js",
    "migrate:professional": "node scripts/migrateProfessional.js",
    "check:delivery": "node scripts/checkDelivery.js",
    "test:start": "node scripts/smokeStart.js",
    "check:config": "node scripts/checkConfig.js",
    "migrate:security": "node scripts/migrateSecurity.js",
    "seed:demo": "node scripts/seedDemo.js",
    "lint": "node scripts/checkUI.js && node scripts/checkSecurity.js",
    "check:seed": "node scripts/checkDemoSeed.js"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "dotenv": "^16.4.5",
    "ejs": "^3.1.10",
    "express": "^4.21.1",
    "express-session": "^1.18.1",
    "mongodb": "^6.10.0",
    "nodemailer": "^10.2.1",
    "pg-promise": "^11.10.2"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "nodemon": "^3.1.7",
    "supertest": "^7.3.1"
  },
  "engines": {
    "node": ">=22"
  }
}
