# Copy to .env.test locally and fill in the PostgreSQL password.
# These database names are enforced to prevent tests touching real app data.
NODE_ENV=test
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=sherubtse_freelance_test_db
DB_USER=postgres
DB_PASS=your_test_postgresql_password
DB_SSL=false
# Leave blank when using the separate DB_* settings.
DATABASE_URL=
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=sherubtse_freelance_test_feedback
TEST_DB_ADMIN_NAME=postgres
SESSION_SECRET=test-only-disposable-session-secret
APP_URL=http://localhost:3000
# Email is mocked. No Gmail credentials are required for tests.
GMAIL_USER=test-sender@example.invalid
GMAIL_APP_PASSWORD=unused-test-placeholder
