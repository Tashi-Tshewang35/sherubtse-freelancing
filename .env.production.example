NODE_ENV=production
HOST=0.0.0.0
PORT=3000
APP_URL=https://your-public-domain.example
TRUST_PROXY_HOPS=1
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
DATABASE_URL=postgresql://username:password@database-host:5432/sherubtse_freelance_db
DB_SSL=true
MONGODB_URI=mongodb+srv://username:password@cluster-host/
MONGODB_DB=sherubtse_freelance_feedback
GMAIL_USER=your_sender_account@gmail.com
GMAIL_APP_PASSWORD=your_google_app_password
ADMIN_NAME=System Administrator
ADMIN_EMAIL=your_admin_email@example.com
ADMIN_PASSWORD=your_admin_password

# Alternatively, leave DATABASE_URL unset and use the exact separate field names:
# DB_HOST=your_hosted_postgresql_host
# DB_PORT=5432
# DB_NAME=your_hosted_database
# DB_USER=your_hosted_database_user
# DB_PASS=your_hosted_database_password
# APP_URL must be the actual HTTPS service URL before production startup.
