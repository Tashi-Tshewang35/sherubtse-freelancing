# Checklist only. Add real values privately in Render Environment.
NODE_ENV=production
HOST=0.0.0.0
# Render supplies RENDER_EXTERNAL_URL; leave APP_URL blank to use it.
APP_URL=
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
DATABASE_URL=postgresql://your_user:your_password@your_host/your_database
DB_SSL=true
MONGODB_URI=mongodb+srv://your_user:your_password@your_cluster/
MONGODB_DB=sherubtse_freelance_feedback
EMAIL_PROVIDER=gmail-api
GMAIL_USER=your_sender@gmail.com
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_REFRESH_TOKEN=your_google_refresh_token
# Alternative with a verified domain: EMAIL_PROVIDER=resend
# RESEND_API_KEY=your_resend_api_key
# EMAIL_FROM=Sherubtse Freelancing <noreply@your-verified-domain.com>
# For Gmail on an SMTP-capable host instead, use EMAIL_PROVIDER=gmail:
# GMAIL_USER=your_sender@gmail.com
# GMAIL_APP_PASSWORD=your_google_app_password
